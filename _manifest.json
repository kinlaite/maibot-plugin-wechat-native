{
  "manifest_version": 2,
  "id": "neozhu.wechat-native-adapter",
  "version": "1.1.0",
  "name": "微信 Native 适配器",
  "display": {
    "icon": {
      "type": "local",
      "value": "assets/icon.svg",
      "fallback": "message-circle"
    }
  },
  "description": "通过 agent-wechat-native /v1 API 把个人微信接入麦麦，支持私聊与群聊的文本、图片、语音和引用回复。移植自 AstrBot 插件 astrbot-plugin-wechat-native（作者 neozhu，MIT）。",
  "author": {
    "name": "kinlaite"
  },
  "urls": {
    "repository": "https://github.com/kinlaite/maibot-plugin-wechat-native"
  },
  "license": "MIT",
  "plugin_type": "adapter",
  "host_application": {
    "min_version": "1.4.0",
    "max_version": "1.4.99"
  },
  "sdk": {
    "min_version": "2.23.0",
    "max_version": "2.23.99"
  },
  "dependencies": [
    {"type": "python_package", "name": "aiohttp", "version_spec": ">=3.11.18,<4"},
    {"type": "python_package", "name": "pypdf", "version_spec": ">=6.1.1,<7"},
    {"type": "python_package", "name": "pillow", "version_spec": ">=11,<14"},
    {"type": "python_package", "name": "msgpack", "version_spec": ">=1.0,<2"}
  ],
  "capabilities": [
    "gateway.route_message",
    "gateway.update_state",
    "component.enable",
    "component.disable",
    "message.get_by_id",
    "chat.get_all_streams"
  ],
  "i18n": {
    "default_locale": "zh-CN",
    "supported_locales": [
      "zh-CN"
    ]
  }
}
